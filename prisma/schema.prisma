generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// 시스템 / 인증
// ─────────────────────────────────────────

model User {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String    @unique
  name        String?
  passwordHash String?  @map("password_hash")
  role        String    @default("member")
  groupId     String?   @map("group_id") @db.Uuid
  group       Group?    @relation(fields: [groupId], references: [id])
  isActive    Boolean   @default(true) @map("is_active")
  invitedById String?   @map("invited_by") @db.Uuid
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  auditLogs AuditLog[]
  campaigns Campaign[]
  journeys  Journey[]

  @@index([email])
  @@map("users")
}

model Group {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  permissions Json?
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  users User[]

  @@map("groups")
}

model InviteToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String    @unique
  email     String
  role      String
  groupId   String?   @map("group_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([token])
  @@map("invite_tokens")
}

model AuditLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  user          User?    @relation(fields: [userId], references: [id])
  action        String
  resource      String
  resourceId    String?  @map("resource_id")
  ip            String?
  userAgent     String?  @map("user_agent")
  payloadBefore Json?    @map("payload_before")
  payloadAfter  Json?    @map("payload_after")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────
// 고객 / CDP
// ─────────────────────────────────────────

model Customer {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  unifiedId String?  @map("unified_id") @db.Uuid
  email     String?
  phone     String?
  name      String?
  gender    String?
  birthYear Int?     @map("birth_year")
  skinType  String?  @map("skin_type")
  segment   String?
  rfmScore  Json?    @map("rfm_score")
  ltv       Decimal? @db.Decimal(15, 2)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  identities         CustomerIdentity[]
  events             CustomerEvent[]
  orders             Order[]
  campaignSends      CampaignSend[]
  journeyEnrollments JourneyEnrollment[]

  @@index([email])
  @@index([phone])
  @@index([unifiedId])
  @@index([segment])
  @@map("customers")
}

model CustomerIdentity {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId      String   @map("customer_id") @db.Uuid
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel         String
  channelUserId   String   @map("channel_user_id")
  identifierType  String   @map("identifier_type")
  identifierValue String   @map("identifier_value")
  confidenceScore Decimal  @default(1.0) @map("confidence_score") @db.Decimal(3, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([customerId])
  @@index([channel, channelUserId])
  @@map("customer_identities")
}

model CustomerEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  eventType   String   @map("event_type")
  channel     String?
  skuMasterId String?  @map("sku_master_id") @db.Uuid
  meta        Json?
  occurredAt  DateTime @default(now()) @map("occurred_at")

  @@index([customerId])
  @@index([eventType])
  @@index([occurredAt])
  @@map("customer_events")
}

// ─────────────────────────────────────────
// 상품 / SKU
// ─────────────────────────────────────────

model SkuMaster {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String?   @map("tenant_id") @db.Uuid
  skuCode      String    @unique @map("sku_code")
  name         String
  category     String
  subCategory  String?   @map("sub_category")
  ingredients  Json?
  unitCost     Decimal?  @map("unit_cost") @db.Decimal(15, 2)
  sellingPrice Decimal?  @map("selling_price") @db.Decimal(15, 2)
  lotExpiry    DateTime? @map("lot_expiry")
  isBundle     Boolean   @default(false) @map("is_bundle")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")

  aliases     SkuAlias[]
  bundleItems SkuBundle[] @relation("BundleSku")
  components  SkuBundle[] @relation("ComponentSku")
  inventory   Inventory[]
  orderItems  OrderItem[]
  vocReviews  VocReview[]

  @@index([skuCode])
  @@index([category])
  @@index([isBundle])
  @@map("sku_master")
}

model SkuAlias {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  skuMasterId String    @map("sku_master_id") @db.Uuid
  skuMaster   SkuMaster @relation(fields: [skuMasterId], references: [id], onDelete: Cascade)
  channel     String
  aliasCode   String    @map("alias_code")
  aliasName   String?   @map("alias_name")
  isVerified  Boolean   @default(false) @map("is_verified")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([channel, aliasCode])
  @@map("sku_aliases")
}

model SkuBundle {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bundleSkuId    String    @map("bundle_sku_id") @db.Uuid
  bundleSku      SkuMaster @relation("BundleSku", fields: [bundleSkuId], references: [id])
  componentSkuId String    @map("component_sku_id") @db.Uuid
  componentSku   SkuMaster @relation("ComponentSku", fields: [componentSkuId], references: [id])
  qty            Int
  costRatio      Decimal   @map("cost_ratio") @db.Decimal(5, 4)
  isGift         Boolean   @default(false) @map("is_gift")

  @@map("sku_bundles")
}

model Inventory {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  skuMasterId  String    @map("sku_master_id") @db.Uuid
  skuMaster    SkuMaster @relation(fields: [skuMasterId], references: [id], onDelete: Cascade)
  channel      String
  qtyAvailable Int       @default(0) @map("qty_available")
  qtyReserved  Int       @default(0) @map("qty_reserved")
  reorderPoint Int       @default(10) @map("reorder_point")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([skuMasterId, channel])
  @@index([skuMasterId])
  @@map("inventory")
}

// ─────────────────────────────────────────
// 주문
// ─────────────────────────────────────────

model Order {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  customer       Customer @relation(fields: [customerId], references: [id])
  channel        String
  channelOrderId String?  @map("channel_order_id")
  totalAmount    Decimal  @map("total_amount") @db.Decimal(15, 2)
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(15, 2)
  status         String
  orderedAt      DateTime @map("ordered_at")
  createdAt      DateTime @default(now()) @map("created_at")

  items OrderItem[]

  @@index([customerId])
  @@index([channel])
  @@index([orderedAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String    @map("order_id") @db.Uuid
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  skuMasterId  String    @map("sku_master_id") @db.Uuid
  skuMaster    SkuMaster @relation(fields: [skuMasterId], references: [id])
  qty          Int
  unitPrice    Decimal   @map("unit_price") @db.Decimal(15, 2)
  lotNumber    String?   @map("lot_number")
  isBundleItem Boolean   @default(false) @map("is_bundle_item")
  parentItemId String?   @map("parent_item_id") @db.Uuid

  @@index([orderId])
  @@map("order_items")
}

model ChannelOrderRaw {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channel      String
  rawJson      Json     @map("raw_json")
  processed    Boolean  @default(false)
  errorMessage String?  @map("error_message")
  ingestedAt   DateTime @default(now()) @map("ingested_at")

  @@index([channel])
  @@index([processed])
  @@index([ingestedAt])
  @@map("channel_orders_raw")
}

// ─────────────────────────────────────────
// 마케팅
// ─────────────────────────────────────────

model Campaign {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  type          String
  status        String    @default("draft")
  segmentFilter Json?     @map("segment_filter")
  abTest        Json?     @map("ab_test")
  scheduledAt   DateTime? @map("scheduled_at")
  sentAt        DateTime? @map("sent_at")
  createdById   String?   @map("created_by") @db.Uuid
  createdBy     User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now()) @map("created_at")

  sends               CampaignSend[]
  influencerCampaigns InfluencerCampaign[]

  @@index([status])
  @@map("campaigns")
}

model CampaignSend {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId  String    @map("campaign_id") @db.Uuid
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerId  String    @map("customer_id") @db.Uuid
  customer    Customer  @relation(fields: [customerId], references: [id])
  variant     String?
  status      String    @default("sent")
  sentAt      DateTime? @map("sent_at")
  openedAt    DateTime? @map("opened_at")
  clickedAt   DateTime? @map("clicked_at")
  convertedAt DateTime? @map("converted_at")
  revenueAttr Decimal?  @map("revenue_attr") @db.Decimal(15, 2)

  @@index([campaignId])
  @@index([customerId])
  @@index([status])
  @@map("campaign_sends")
}

model Journey {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  triggerType   String   @map("trigger_type")
  triggerConfig Json?    @map("trigger_config")
  steps         Json?
  isActive      Boolean  @default(true) @map("is_active")
  createdById   String?  @map("created_by") @db.Uuid
  createdBy     User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now()) @map("created_at")

  enrollments JourneyEnrollment[]

  @@map("journeys")
}

model JourneyEnrollment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  journeyId   String   @map("journey_id") @db.Uuid
  journey     Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  customerId  String   @map("customer_id") @db.Uuid
  customer    Customer @relation(fields: [customerId], references: [id])
  currentStep Int      @default(0) @map("current_step")
  status      String   @default("active")
  enrolledAt  DateTime @default(now()) @map("enrolled_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([journeyId, customerId])
  @@index([status])
  @@map("journey_enrollments")
}

model Influencer {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  channel       String
  handle        String
  followerCnt   Int?     @map("follower_cnt")
  avgEngagement Decimal? @map("avg_engagement") @db.Decimal(5, 2)
  avgRoi        Decimal? @map("avg_roi") @db.Decimal(10, 2)
  skinTypeFocus String?  @map("skin_type_focus")
  categoryFocus String[] @map("category_focus")
  contact       String?
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  campaigns InfluencerCampaign[]

  @@map("influencers")
}

model InfluencerCampaign {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  influencerId      String    @map("influencer_id") @db.Uuid
  influencer        Influencer @relation(fields: [influencerId], references: [id])
  campaignId        String    @map("campaign_id") @db.Uuid
  campaign          Campaign  @relation(fields: [campaignId], references: [id])
  utmCode           String    @unique @map("utm_code")
  couponCode        String?   @map("coupon_code")
  fee               Decimal?  @db.Decimal(15, 2)
  revenueAttributed Decimal?  @map("revenue_attributed") @db.Decimal(15, 2)
  roi               Decimal?  @db.Decimal(10, 2)
  startedAt         DateTime? @map("started_at")
  endedAt           DateTime? @map("ended_at")

  @@map("influencer_campaigns")
}

// ─────────────────────────────────────────
// VOC / 리뷰
// ─────────────────────────────────────────

model VocReview {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  skuMasterId     String    @map("sku_master_id") @db.Uuid
  skuMaster       SkuMaster @relation(fields: [skuMasterId], references: [id])
  channel         String
  channelReviewId String?   @map("channel_review_id")
  rating          Int?
  content         String?
  sentiment       String?
  tags            Json?
  lotNumber       String?   @map("lot_number")
  isAlert         Boolean   @default(false) @map("is_alert")
  ingestedAt      DateTime  @default(now()) @map("ingested_at")
  analyzedAt      DateTime? @map("analyzed_at")

  @@index([skuMasterId])
  @@index([channel])
  @@index([sentiment])
  @@index([ingestedAt])
  @@map("voc_reviews")
}

// ─────────────────────────────────────────
// 영업 파이프라인
// ─────────────────────────────────────────

model Account {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  type         String
  contactName  String?  @map("contact_name")
  contactPhone String?  @map("contact_phone")
  contactEmail String?  @map("contact_email")
  address      String?
  paymentTerms String?  @map("payment_terms")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  deals Deal[]

  @@map("accounts")
}

model Deal {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId     String    @map("account_id") @db.Uuid
  account       Account   @relation(fields: [accountId], references: [id])
  title         String
  stage         String    @default("LEAD")
  amount        Decimal   @db.Decimal(15, 2)
  probability   Int       @default(50)
  assigneeId    String?   @map("assignee_id") @db.Uuid
  expectedClose DateTime? @map("expected_close")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([stage])
  @@index([assigneeId])
  @@map("deals")
}

// ─────────────────────────────────────────
// 워크스페이스 (멀티테넌트)
// ─────────────────────────────────────────

model Workspace {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  industry  String   @default("general")
  plan      String   @default("starter")
  settings  Json?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  modules WorkspaceModule[]

  @@map("workspaces")
}

model WorkspaceModule {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  moduleKey    String    @map("module_key")
  isEnabled    Boolean   @default(false) @map("is_enabled")
  config       Json?
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([workspaceId, moduleKey])
  @@index([workspaceId])
  @@map("workspace_modules")
}

// ─────────────────────────────────────────
// 물류 — 발주·수주
// ─────────────────────────────────────────

model PurchaseOrder {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNo     String              @unique @map("order_no")
  type        String              // 'purchase' | 'sales'
  partnerId   String?             @map("partner_id") @db.Uuid
  partnerName String?             @map("partner_name")
  status      String              @default("draft")
  totalAmount Decimal?            @map("total_amount") @db.Decimal(15, 2)
  notes       String?
  dueDate     DateTime?           @map("due_date")
  issuedAt    DateTime?           @map("issued_at")
  createdById String?             @map("created_by") @db.Uuid
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  items PurchaseOrderItem[]

  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId         String        @map("order_id") @db.Uuid
  order           PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  skuMasterId     String?       @map("sku_master_id") @db.Uuid
  skuCode         String?       @map("sku_code")
  skuName         String?       @map("sku_name")
  qty             Int
  unitPrice       Decimal       @map("unit_price") @db.Decimal(15, 2)
  lotNumber       String?       @map("lot_number")

  @@index([orderId])
  @@map("purchase_order_items")
}

// ─────────────────────────────────────────
// 물류 — 창고·입출고
// ─────────────────────────────────────────

model WarehouseLocation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique
  name      String
  zone      String?
  capacity  Int?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  movements StockMovement[]

  @@map("warehouse_locations")
}

model StockMovement {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          String             // 'inbound' | 'outbound' | 'transfer' | 'return' | 'adjust'
  skuMasterId   String?            @map("sku_master_id") @db.Uuid
  skuCode       String?            @map("sku_code")
  skuName       String?            @map("sku_name")
  locationId    String?            @map("location_id") @db.Uuid
  location      WarehouseLocation? @relation(fields: [locationId], references: [id])
  qty           Int
  lotNumber     String?            @map("lot_number")
  lotExpiry     DateTime?          @map("lot_expiry")
  referenceType String?            @map("reference_type")
  referenceId   String?            @map("reference_id") @db.Uuid
  notes         String?
  createdById   String?            @map("created_by") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at")

  @@index([type])
  @@index([skuMasterId])
  @@index([locationId])
  @@index([createdAt])
  @@map("stock_movements")
}

// ─────────────────────────────────────────
// 물류 — 배송 추적
// ─────────────────────────────────────────

model Shipment {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trackingNo       String?   @map("tracking_no")
  carrier          String?
  status           String    @default("preparing") // preparing | shipped | in_transit | delivered | failed
  customerId       String?   @map("customer_id") @db.Uuid
  orderId          String?   @map("order_id") @db.Uuid
  recipientName    String?   @map("recipient_name")
  recipientPhone   String?   @map("recipient_phone")
  recipientAddress String?   @map("recipient_address")
  weight           Decimal?  @db.Decimal(8, 2)
  boxCount         Int?      @map("box_count")
  shippedAt        DateTime? @map("shipped_at")
  deliveredAt      DateTime? @map("delivered_at")
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([trackingNo])
  @@index([status])
  @@index([customerId])
  @@index([createdAt])
  @@map("shipments")
}

// ─────────────────────────────────────────
// 물류 — 반품 관리
// ─────────────────────────────────────────

model Return {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  returnNo     String    @unique @map("return_no")
  customerId   String?   @map("customer_id") @db.Uuid
  orderId      String?   @map("order_id") @db.Uuid
  trackingNo   String?   @map("tracking_no")
  reason       String?
  status       String    @default("requested") // requested | received | inspecting | restocked | refunded | rejected
  refundAmount Decimal?  @map("refund_amount") @db.Decimal(15, 2)
  notes        String?
  receivedAt   DateTime? @map("received_at")
  resolvedAt   DateTime? @map("resolved_at")
  createdById  String?   @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  items ReturnItem[]

  @@index([status])
  @@index([customerId])
  @@index([createdAt])
  @@map("returns")
}

model ReturnItem {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  returnId    String  @map("return_id") @db.Uuid
  return      Return  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  skuMasterId String? @map("sku_master_id") @db.Uuid
  skuCode     String? @map("sku_code")
  skuName     String? @map("sku_name")
  qty         Int
  condition   String? // 'good' | 'damaged' | 'expired'
  lotNumber   String? @map("lot_number")

  @@index([returnId])
  @@map("return_items")
}

// ─────────────────────────────────────────
// 물류 — 거래처 정산
// ─────────────────────────────────────────

model Settlement {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerId   String?   @map("partner_id") @db.Uuid
  partnerName String?   @map("partner_name")
  period      String    // '2024-01'
  totalAmount Decimal   @map("total_amount") @db.Decimal(15, 2)
  status      String    @default("draft") // draft | confirmed | paid
  dueDate     DateTime? @map("due_date")
  paidAt      DateTime? @map("paid_at")
  notes       String?
  createdById String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([partnerId])
  @@index([period])
  @@index([status])
  @@map("settlements")
}

// ─────────────────────────────────────────
// 물류 — AI 수요예측
// ─────────────────────────────────────────

model DemandForecast {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  skuMasterId   String   @map("sku_master_id") @db.Uuid
  skuCode       String   @map("sku_code")
  skuName       String   @map("sku_name")
  forecastDate  DateTime @map("forecast_date")
  forecastQty   Int      @map("forecast_qty")
  actualQty     Int?     @map("actual_qty")
  confidence    Decimal? @db.Decimal(4, 3)
  modelVersion  String?  @map("model_version")
  factors       Json?
  computedAt    DateTime @default(now()) @map("computed_at")

  @@index([skuMasterId])
  @@index([forecastDate])
  @@map("demand_forecasts")
}

// ─────────────────────────────────────────
// 관리자
// ─────────────────────────────────────────

model ApiConnection {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  channel        String
  endpoint       String
  authType       String    @map("auth_type")
  tokenEncrypted String?   @map("token_encrypted")
  refreshToken   String?   @map("refresh_token")
  tokenExpiresAt DateTime? @map("token_expires_at")
  status         String    @default("disconnected")
  lastLatencyMs  Int?      @map("last_latency_ms")
  lastCheckedAt  DateTime? @map("last_checked_at")
  errorMessage   String?   @map("error_message")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("api_connections")
}

model BiCache {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key        String   @unique
  data       Json
  computedAt DateTime @default(now()) @map("computed_at")

  @@map("bi_cache")
}
